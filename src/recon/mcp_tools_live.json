{
  "module": [
    {
      "name": "fetch_record",
      "title": "Fetch Record",
      "description": "Get record from database as per filter query.",
      "tags": [
        "module_tool",
        "fetch_record"
      ],
      "inputSchema": {
        "$defs": {
          "FetchRecordRequest": {
            "description": "Retrieve records from a main module, leveraging interlinked modules as needed.\nUse get_module_list or get_module_fields to latest module and fields.\n\nExample:\n{\n  \"module_id\": \"module_name\",\n  \"filters\": [\n    {\"type\":\"field\",\"field\":\"field_name\",\"operator\":\"gt\",\"value\":100},\n    {\"type\":\"field\",\"linked_module_id\":\"field_name\",\"linked_field_id\":\"field_name\",\"operator\":\"eq\",\"value\":\"Active\"},\n    {\n      \"logic\":\"OR\",\"filters\":[\n        {\"type\":\"field\",\"field\":\"field_name\",\"operator\":\"like\",\"value\":\"S%\"},\n        {\"type\":\"field\",\"linked_module_id\":\"field_name\",\"linked_field_id\":\"linked_field_name\",\"operator\":\"in\",\"value\":[1,2,3]}\n      ]\n    }\n  ],\n  \"logic\": \"AND\",\n  \"limit\": 50,\n  \"select\": [\"field_name\",\"field_name\",\"field_name\"],\n  \"sort\": [\n    {\"field\":\"field_name\",\"direction\":\"DESC\"}\n  ]\n}",
            "properties": {
              "module_id": {
                "description": "Main module ID to retrieve records from (e.g., 'module_id').",
                "type": "string"
              },
              "filters": {
                "description": "Field/group filters. FieldFilter supports main or linked targets.",
                "items": {
                  "$ref": "#/$defs/FilterExpression"
                },
                "type": "array"
              },
              "logic": {
                "default": "AND",
                "description": "Top-level logic for combining filters at the root level.",
                "enum": [
                  "AND",
                  "OR"
                ],
                "type": "string"
              },
              "limit": {
                "anyOf": [
                  {
                    "minimum": 1,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": 30,
                "description": "Maximum number of records to return."
              },
              "sort": {
                "anyOf": [
                  {
                    "items": {
                      "$ref": "#/$defs/SortRule"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Optional sort rules by main or linked fields."
              },
              "select": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Main module field IDs to include in results (e.g., ['field_name','field_name'])."
              }
            },
            "required": [
              "module_id",
              "filters"
            ],
            "type": "object"
          },
          "FieldFilter": {
            "description": "Unified filter supporting either:\n- Main field filter: field='field_name'\n- Linked field filter: linked_module_id='linked_module_id' and linked_field_id='linked_field_name'\n\nExactly one mode must be used at a time.\n\nExamples:\n  Main:   field='field_name', operator='gt', value=100\n  Linked: linked_module_id='linked_module_id', linked_field_id='linked_field_name', operator='eq', value='Active'",
            "properties": {
              "type": {
                "const": "field",
                "default": "field",
                "description": "Discriminator for a field-based filter (main or linked).",
                "type": "string"
              },
              "field": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Main module field ID (e.g., 'field_name'). Use this for main-field filtering."
              },
              "linked_module_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Linked module ID for linked-field filtering (e.g., 'linked_module_id')."
              },
              "linked_field_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Linked module field ID (e.g., 'linked_field_name') used with linked_module_id."
              },
              "operator": {
                "description": "Comparison operator. 'like'/'notlike' use % and _. 'isnull' checks for nulls.",
                "enum": [
                  "eq",
                  "neq",
                  "gt",
                  "lt",
                  "gte",
                  "lte",
                  "like",
                  "notlike",
                  "in",
                  "nin",
                  "isnull"
                ],
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    "type": "array"
                  }
                ],
                "description": "Value to compare against. For 'in'/'nin', provide a list. For 'like', use %/_. "
              }
            },
            "required": [
              "operator",
              "value"
            ],
            "type": "object"
          },
          "FilterExpression": {
            "anyOf": [
              {
                "$ref": "#/$defs/FieldFilter"
              },
              {
                "$ref": "#/$defs/FilterGroup"
              }
            ],
            "description": "A single filter expression: either a field filter (main/linked) or a logical group."
          },
          "FilterGroup": {
            "description": "Group multiple filters using a logical operator. Supports recursive nesting.",
            "properties": {
              "logic": {
                "description": "How to combine the nested filters.",
                "enum": [
                  "AND",
                  "OR"
                ],
                "type": "string"
              },
              "filters": {
                "description": "Nested filter expressions or further groups.",
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/FilterExpression"
                    },
                    {
                      "$ref": "#/$defs/FilterGroup"
                    }
                  ]
                },
                "type": "array"
              }
            },
            "required": [
              "logic",
              "filters"
            ],
            "type": "object"
          },
          "SortRule": {
            "description": "Sorting rule for results.\n- For main-field sort: set field='F#'\n- For linked-field sort: set linked_module_id='linked_module_id' and linked_field_id='field_name'\nExactly one mode must be used.",
            "properties": {
              "field": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Main module field ID to sort by (e.g., 'field_name'). Not valid with linked_* fields."
              },
              "direction": {
                "default": "ASC",
                "description": "Sort direction: 'ASC' or 'DESC'. Default 'ASC'.",
                "enum": [
                  "ASC",
                  "DESC"
                ],
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "params": {
            "$ref": "#/$defs/FetchRecordRequest"
          }
        },
        "required": [
          "params"
        ],
        "type": "object"
      }
    },
